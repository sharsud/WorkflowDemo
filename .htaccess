RewriteEngine On

RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^api/(auth|cart|admin)/([A-Za-z0-9_-]+)/?$ api/$1/$2.php [L,QSA]
RewriteRule ^api/(products|cart|orders|reset)/?$ api/$1.php [L,QSA]
